#--------------------------------------------------------------------
# Modelo de configuração do Sistema CT
# Copie para .env (cp env.example .env) e preencha a senha do banco.
# O arquivo .env NÃO é versionado: credenciais ficam fora do código.
#--------------------------------------------------------------------

# Ambiente: development (mostra erros) ou production (esconde erros)
CI_ENVIRONMENT = development

# Endereço da aplicação
app.baseURL = 'http://localhost:8080/'

# Banco de dados MySQL
database.default.hostname = localhost
database.default.database = ct_devweb
database.default.username = ct_user
database.default.password = sua_senha_aqui
database.default.DBDriver = MySQLi
database.default.port = 3306
